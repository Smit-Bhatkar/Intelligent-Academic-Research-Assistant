# Copy this file to .env at the repo root before running docker-compose,
# or to backend/.env if running the backend standalone.

APP_NAME="Intelligent Academic Research Assistant"
ENV=development

# SQLite for dev. Swap to Postgres later, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./ara.db

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173"]

# Phase 2 — not required for arXiv, needed later for Semantic Scholar/CrossRef
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

# Phase 3 — LLM providers, not wired yet
GEMINI_API_KEY=
GROQ_API_KEY=
